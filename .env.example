# OFFSPACE Configuration
# Use "openai" or "local" for the default chat provider.
OFFSPACE_DEFAULT_PROVIDER=openai
# The backend accepts either OPENAI_API_KEY or OFFSPACE_OPENAI_API_KEY.
OPENAI_API_KEY=
OFFSPACE_LOCAL_AI_URL=http://127.0.0.1:11434
OFFSPACE_LOCAL_AI_MODEL=llama3.2
OFFSPACE_LOCATION=Your Location
OFFSPACE_OWNER_NAME=Your Name
OFFSPACE_DEBUG=false
OFFSPACE_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./offspace.db
OFFSPACE_SECRET_KEY=replace-with-strong-secret
# Alternatively set JWT_SECRET_KEY instead of OFFSPACE_SECRET_KEY
# ENVIRONMENT=development
